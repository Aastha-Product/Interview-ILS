# Staging settings: a production build with test data only (see docs/deploy.md).
# Don't copy this file onto the server: enter each value in the host's secret settings.
# Never put real keys in this file or commit a filled-in copy.

# Shows the "test data only" banner, keeps search engines out, and allows `pnpm db:seed -- --email ...`.
APP_ENV=staging
NODE_ENV=production

# Managed Postgres for staging only (never the production database). Require TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pathfinder_staging?sslmode=require

# A long random value, different from production: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Google OAuth client for staging (its own client, redirect URI https://STAGING_HOST/api/auth/callback/google).
# While the OAuth app is in "Testing", only the test users you add in Google Cloud Console can sign in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Empty = mock AI (free, predictable). To try Gemini, use a paid-tier key and a pinned model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
FALLBACK_AI_BASE_URL=
FALLBACK_AI_API_KEY=
FALLBACK_AI_MODEL=

# Empty = recorded sample jobs. Live keys share the daily budgets with nothing else on staging.
JSEARCH_API_KEY=
JSEARCH_DAILY_BUDGET=2
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_DAILY_BUDGET=10
SEARCH_COOLDOWN_SECONDS=300
SEARCH_CACHE_HOURS=24

TAILOR_DAILY_LIMIT=20
AI_CONCURRENT_PER_USER=2
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_SIGNIN_PER_MINUTE=10

# Object storage is required outside development. A separate, private bucket for staging.
# Cloudflare R2: S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com and S3_REGION=auto
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=pathfinder-staging
S3_ACCESS_KEY=
S3_SECRET_KEY=

SENTRY_DSN=
APP_URL=https://STAGING_HOST
# 1 behind the host's load balancer; 2 if a CDN (e.g. Cloudflare proxy) is also in front.
TRUSTED_PROXY_HOPS=1
LOG_LEVEL=info
