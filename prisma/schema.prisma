// Dossier's data model (PRD §9). After editing, run
// `docker/bin/yarn prisma migrate dev --name <name>` and `docker compose restart app`.
//
// Conventions:
// - The profile's basics and the settings are key-value tables (ProfileField,
//   Setting): one text row per key, and a missing key means empty or the
//   default. Code maps the keys to typed fields (src/lib/profile.ts,
//   src/lib/settings.ts), so a new field needs no migration.
// - Text fields the user fills in are non-null and default to "", so forms can
//   autosave partial entries without null checks.
// - `sort` orders entries within a list; lower comes first.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Profile (E2-1) ──────────────────────────────────────────────────────────

/// The profile's basics (name, headline, contact details, summary…), one row
/// per filled-in field. The keys and how each value is written are in
/// src/lib/profile.ts (PROFILE_KEYS); a missing key means empty.
// ─── Users (Pathfinder) ──────────────────────────────────────────────────────

/// A student with a private account. Everything they store belongs to them and is deleted with them.
model User {
  id             String   @id @default(cuid())
  email          String   @unique @db.Citext
  /// The Google account the student signs in with: Google's stable id ("sub"), which outlives an email change.
  googleSub      String?  @unique
  /// The Firebase Authentication account the student signs in with: Firebase's stable user id.
  firebaseUid    String?  @unique
  /// Every session token carries the version it was made with; signing out raises it, which ends all of the student's sessions.
  sessionVersion Int      @default(0)
  /// AI requests a day on the server's shared key, set by an admin for this student; null means the server's PATHFINDER_AI_DAILY_LIMIT.
  aiDailyLimit   Int?
  name           String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profileFields    ProfileField[]
  skills           Skill[]
  languages        Language[]
  experiences      Experience[]
  experienceSkills ExperienceSkill[]
  projects         Project[]
  projectSkills    ProjectSkill[]
  educations       Education[]
  publications     Publication[]
  references       Reference[]
  facts            Fact[]
  themes           Theme[]
  settings         Setting[]
  applications     Application[]
  statusEvents     StatusEvent[]
  documents        Document[]
  documentVersions DocumentVersion[]
  chatMessages     ChatMessage[]
  notes            Note[]
  postings         Posting[]
  claudePastes     ClaudePaste[]
  agentCandidates  AgentCandidate[]
  postingScores    PostingScore[]
  postingSearchs   PostingSearch[]
  startups         Startup[]
  startupBlocks    StartupBlock[]
  googleAccounts   GoogleAccount[]
  emailMessages    EmailMessage[]
  jobs             Job[]
  feedback         Feedback[]
  aiUsage          AiUsage[]
  aiCalls          AiCall[]
  resumeAnalyses   ResumeAnalysis[]
  jobMatches       JobMatch[]
  autoApply        AutoApplySettings?
  applyTasks       ApplyTask[]
  extensionTokens  ExtensionToken[]
}

model ProfileField {
  /// The student this belongs to.
  userId    String   @default(dbgenerated("current_setting('app.user_id')"))
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([userId, key])
}

model Skill {
  /// The student this belongs to.
  userId      String            @default(dbgenerated("current_setting('app.user_id')"))
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  id          String            @id @default(cuid())
  /// Unique ignoring case ("Figma" and "figma" are the same skill).
  name        String            @db.Citext
  sort        Int               @default(0)
  /// The group it's printed under on resumes ("Technical SEO"); empty for none (#280).
  group       String            @default("")
  experiences ExperienceSkill[]
  projects    ProjectSkill[]
  createdAt   DateTime          @default(now())

  @@unique([userId, name])
}

enum LanguageLevel {
  NATIVE
  C2
  C1
  B2
  B1
  A2
  A1
}

model Language {
  /// The student this belongs to.
  userId    String        @default(dbgenerated("current_setting('app.user_id')"))
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  id        String        @id @default(cuid())
  /// Unique ignoring case; adding an existing language updates its level (PRO-4).
  name      String        @db.Citext
  level     LanguageLevel
  sort      Int           @default(0)
  createdAt DateTime      @default(now())

  @@unique([userId, name])
}

/// A role. Dates are month and year; `current` means "Present" (no end date).
model Experience {
  /// The student this belongs to.
  userId     String            @default(dbgenerated("current_setting('app.user_id')"))
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  id         String            @id @default(cuid())
  role       String            @default("")
  company    String            @default("")
  location   String            @default("")
  /// One line about the company or the role, under its title on resumes as written (#257).
  descriptor String            @default("")
  startYear  Int?
  /// 1–12, or null when only the year is known.
  startMonth Int?
  endYear    Int?
  endMonth   Int?
  current    Boolean           @default(false)
  /// One point per line.
  bullets    String            @default("")
  sort       Int               @default(0)
  skills     ExperienceSkill[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId])
}

/// A skill used in a role (PRO-6). Deleting either side removes the link (PRO-3).
model ExperienceSkill {
  /// The student this belongs to.
  userId       String     @default(dbgenerated("current_setting('app.user_id')"))
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  experienceId String
  skillId      String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([experienceId, skillId])
  @@index([skillId])
  @@index([userId])
}

/// A side, open-source, course or thesis project (PRO-13). Dates work as in Experience.
model Project {
  /// The student this belongs to.
  userId     String         @default(dbgenerated("current_setting('app.user_id')"))
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  id         String         @id @default(cuid())
  name       String         @default("")
  /// Where it can be seen, e.g. its repository or site.
  link       String         @default("")
  startYear  Int?
  startMonth Int?
  endYear    Int?
  endMonth   Int?
  current    Boolean        @default(false)
  /// One point per line.
  bullets    String         @default("")
  sort       Int            @default(0)
  skills     ProjectSkill[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId])
}

/// A skill used in a project, as ExperienceSkill is for a role.
model ProjectSkill {
  /// The student this belongs to.
  userId    String  @default(dbgenerated("current_setting('app.user_id')"))
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  skillId   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
  @@index([userId])
}

/// A degree, course or certificate. Dates work as in Experience.
model Education {
  /// The student this belongs to.
  userId     String   @default(dbgenerated("current_setting('app.user_id')"))
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  id         String   @id @default(cuid())
  degree     String   @default("")
  school     String   @default("")
  startYear  Int?
  startMonth Int?
  endYear    Int?
  endMonth   Int?
  current    Boolean  @default(false)
  notes      String   @default("")
  sort       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

/// Private unless included in a document (PRO-8).
/// A publication (#218), cited the way its author wants: no citation style is enforced.
model Publication {
  /// The student this belongs to.
  userId    String   @default(dbgenerated("current_setting('app.user_id')"))
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  id        String   @id @default(cuid())
  /// The citation as written, with **bold** and *italic* marked like that.
  citation  String   @default("")
  /// Where to read it, e.g. its DOI link.
  link      String   @default("")
  /// "Show on resumes": off keeps it in the profile but off every resume.
  onResumes Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Reference {
  /// The student this belongs to.
  userId    String   @default(dbgenerated("current_setting('app.user_id')"))
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  id        String   @id @default(cuid())
  name      String   @default("")
  relation  String   @default("")
  company   String   @default("")
  email     String   @default("")
  phone     String   @default("")
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Something the user tells the AI about themselves: one of the profile's
/// "Facts about me", or one for a single application. Never shown on a
/// document; given to the AI with the profile when it writes.
model Fact {
  /// The student this belongs to.
  userId        String       @default(dbgenerated("current_setting('app.user_id')"))
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  id            String       @id @default(cuid())
  /// The application it's for; null for the profile's own.
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  text          String       @default("")
  sort          Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([applicationId, sort])
  @@index([userId])
}

// ─── Themes and settings (E2-2) ──────────────────────────────────────────────

/// Serifs, then sans, then mono: the order the theme builder lists them.
enum ThemeFont {
  NEWSREADER
  GARAMOND
  SOURCE_SERIF
  LORA
  LIBRE_CASLON
  PLAYFAIR
  FRAUNCES
  GEIST
  PLEX_SANS
  INTER
  MANROPE
  WORK_SANS
  SPACE_GROTESK
  PLEX_MONO
  JETBRAINS_MONO
}

/// Sidebars sit at the start of the line: on the left, or on the right in
/// right-to-left documents.
enum ThemeLayout {
  SINGLE
  /// One column, with each section's title in a narrow column beside it.
  SIDE_HEADINGS
  /// Two columns, with contact details and skills in a sidebar.
  SPLIT
  /// The same with the sidebar at the end of the line.
  SPLIT_END
}

enum ThemeAlign {
  LEFT
  CENTER
}

/// How section titles look.
enum HeadingStyle {
  /// Underlined.
  RULE
  /// Small caps.
  CAPS
  PLAIN
  /// Small caps after a short accent bar.
  BAR
  /// Small caps on a pale band of the accent.
  BAND
}

/// The name, headline and contact details: on the page, or on a block of the accent.
enum HeaderStyle {
  PLAIN
  BANNER
}

/// The sidebar of sidebar layouts: on the page, or on a pale tint of the accent.
enum SidebarStyle {
  PLAIN
  TINTED
}

/// A role's or degree's dates: on its title line, or in a column before it.
enum DateStyle {
  INLINE
  TIMELINE
}

/// The profile photo's shape on a resume (#224). The square shapes show the middle of its 3:4 crop.
enum PhotoShape {
  CIRCLE
  ROUNDED
  SQUARE
  PORTRAIT
}

/// Where a resume shows the profile photo (#224). SIDEBAR needs a sidebar
/// layout; other layouts put it at the end of the header.
enum PhotoPosition {
  HEADER_END
  HEADER_START
  ABOVE_NAME
  SIDEBAR
}

enum Density {
  COMPACT
  REGULAR
  AIRY
}

/// A resume theme (RES-2…RES-4). Built-in themes use their slug as id
/// ("editorial") and are read-only: the app never edits them, the seed keeps
/// them in sync, and a trigger stops them from being deleted.
model Theme {
  /// The student this belongs to. Empty for the built-in ones everyone shares.
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  id            String        @id @default(cuid())
  builtIn       Boolean       @default(false)
  name          String
  headFont      ThemeFont
  bodyFont      ThemeFont
  /// "#rrggbb"
  accent        String
  layout        ThemeLayout   @default(SINGLE)
  align         ThemeAlign    @default(LEFT)
  headingStyle  HeadingStyle  @default(PLAIN)
  density       Density       @default(REGULAR)
  headerStyle   HeaderStyle   @default(PLAIN)
  sidebarStyle  SidebarStyle  @default(PLAIN)
  dateStyle     DateStyle     @default(INLINE)
  photoShape    PhotoShape    @default(CIRCLE)
  photoPosition PhotoPosition @default(HEADER_END)
  documents     Document[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
}

enum AiProvider {
  /// Ollama or llama.cpp on the user's own hardware.
  LOCAL
  /// Any server that speaks the OpenAI chat completions API.
  OPENAI
  ANTHROPIC
  /// Mistral's own API (#206).
  MISTRAL
  /// LM Studio on the user's own hardware (#210).
  LMSTUDIO
}

enum Creativity {
  FAITHFUL
  BALANCED
  EXPRESSIVE
}

enum PaperSize {
  A4
  LETTER
}

enum DateFormat {
  /// 27 September 2026
  DAY_MONTH_YEAR
  /// September 27, 2026
  MONTH_DAY_YEAR
  /// 27-09-2026
  NUMERIC
}

enum Tone {
  WARM
  DIRECT
  FORMAL
}

/// App settings, one row per saved setting; a missing key means the default.
/// The keys, their types and defaults are in src/lib/settings.ts
/// (settingsSchema); the enums above type its values.
model Setting {
  /// The student this belongs to.
  userId    String   @default(dbgenerated("current_setting('app.user_id')"))
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([userId, key])
}

// ─── Applications (E2-3) ─────────────────────────────────────────────────────
// The JSON columns are validated with the zod schemas in src/lib/application-data.ts.

/// PRD §8. Draft…Offer are "in progress"; Accepted, Rejected and Declined are "closed".
enum ApplicationStatus {
  DRAFT
  SENT
  SCREENING
  INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  DECLINED
}

/// How an application was made: by the user, by the job agent (E16), or by auto-apply (Pathfinder).
enum ApplicationOrigin {
  MANUAL
  AGENT
  AUTO_APPLY
}

/// Where a job agent candidate stands (E16).
enum AgentCandidateStatus {
  /// Scored, and waiting for a draft or a dismissal.
  SCORED
  /// A draft is being written.
  DRAFTING
  /// A tailored draft is ready for review.
  DRAFTED
  /// The draft was approved and is a normal application.
  APPROVED
  /// The user passed on it; it never comes back.
  DISMISSED
}

/// The stages the funnel counts, in order (PRD §8, DSH-3).
enum FunnelStage {
  SENT
  SCREENING
  INTERVIEW
  OFFER
  ACCEPTED
}

model Application {
  /// The student this belongs to.
  userId              String            @default(dbgenerated("current_setting('app.user_id')"))
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  id                  String            @id @default(cuid())
  /// Whether the user made it, or the job agent prepared it (E16).
  origin              ApplicationOrigin @default(MANUAL)
  /// The agent's score for the posting, when the agent prepared it.
  agentScore          Int?
  /// An agent draft not approved yet: only the Agent screen shows it (#195).
  awaitingReview      Boolean           @default(false)
  title               String            @default("")
  company             String            @default("")
  role                String            @default("")
  location            String            @default("")
  /// Work mode as written in the posting, e.g. "Hybrid · 3 days in office".
  mode                String            @default("")
  salary              String            @default("")
  deadline            DateTime?         @db.Date
  /// Saved, not fetched (NEW-1).
  postingUrl          String            @default("")
  postingText         String            @default("")
  /// What the AI read from the posting (extractedSchema).
  extracted           Json?
  /// The prompt version that wrote `extracted`, e.g. "extract-posting@1" (E6-5).
  extractedWith       String?
  /// How the posting's requirements match the profile (matchSchema).
  match               Json?
  /// The prompt version that wrote `match`.
  matchedWith         String?
  status              ApplicationStatus @default(DRAFT)
  /// The furthest stage ever reached; null while never sent. Only the status module changes it.
  furthestStage       FunnelStage?
  sentAt              DateTime?
  /// When the next interview is, while the application is in Interview (E9-9); shown on the dashboard.
  nextInterviewAt     DateTime?
  tone                Tone              @default(WARM)
  /// The language the documents were written in, e.g. "English".
  language            String            @default("")
  /// The tailored resume follows its theme's layout, sidebar included; off
  /// means a single column (APP-4, decided in E5-1 #42).
  followThemeLayout   Boolean           @default(false)
  /// Whether the tailored resume shows the profile photo; null follows the
  /// profile's "Show on resumes" (#224).
  showPhoto           Boolean?
  archivedAt          DateTime?
  /// The Gmail thread the application was sent in, when it went out through Gmail (E15-2).
  emailThreadId       String?
  /// The Google Calendar event of the next interview, and the calendar it's
  /// in, when Dossier added it: kept in step with nextInterviewAt both ways.
  interviewEventId    String?
  interviewCalendarId String?
  /// The Find jobs posting it was started from, if any (E14-8).
  posting             Posting?
  /// The agent candidate it was prepared from (E16).
  agentCandidate      AgentCandidate?
  /// The startup it was started from on Startups, if any (#222).
  startup             Startup?
  /// Pathfinder: the auto-apply task that prepared it, if any.
  applyTask           ApplyTask?
  /// Mail sent and received about it through Gmail (E15-3).
  emails              EmailMessage[]
  events              StatusEvent[]
  documents           Document[]
  messages            ChatMessage[]
  notes               Note[]
  /// What the user tells the AI for this application; "Anything I should know?" (NEW-6) becomes the first.
  facts               Fact[]
  /// Its background jobs, deleted with it (their inputs and results hold the posting and the documents).
  jobs                Job[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status])
  @@index([updatedAt])
  @@index([userId])
}

/// One status change. Keeps the application's furthestStage and sentAt from
/// before the change, so the change can be undone (decision in #26).
model StatusEvent {
  /// The student this belongs to.
  userId                String            @default(dbgenerated("current_setting('app.user_id')"))
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  id                    String            @id @default(cuid())
  applicationId         String
  application           Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  from                  ApplicationStatus
  to                    ApplicationStatus
  at                    DateTime          @default(now())
  previousFurthestStage FunnelStage?
  previousSentAt        DateTime?

  @@index([applicationId, at])
  @@index([userId])
}

enum DocumentKind {
  RESUME
  COVER_LETTER
  /// The email that goes with the application, written on request.
  EMAIL
}

/// A tailored resume, cover letter or application email, split into editable units (unitsSchema).
model Document {
  /// The student this belongs to.
  userId        String            @default(dbgenerated("current_setting('app.user_id')"))
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          DocumentKind
  units         Json
  /// The theme it was created with; null falls back to the base theme.
  themeId       String?
  theme         Theme?            @relation(fields: [themeId], references: [id], onDelete: SetNull)
  /// The prompt version that last wrote its units, e.g. "tailor-resume@1" (E6-5).
  writtenWith   String?
  /// Parts left out to fit one page, which can be put back (trimmedSchema, E10-10).
  trimmed       Json?
  /// Earlier states, after each AI change and before each restore (E8-10).
  versions      DocumentVersion[]
  updatedAt     DateTime          @updatedAt

  @@unique([applicationId, kind])
  @@index([userId])
}

/// Why a tailored document has a version (E8-10, APP-13).
enum VersionCause {
  /// The first draft, when the application was created.
  WRITTEN
  /// Left parts out to fit one page, right after writing (E10-10).
  TRIMMED
  /// A part rewritten from its toolbar.
  REGENERATED
  /// Changed from the refine chat.
  REFINED
  /// An AI change undone.
  UNDONE
  /// Saved just before restoring another version, so nothing is lost.
  BEFORE_RESTORE
  /// An earlier version brought back.
  RESTORED
}

/// A tailored document's units as they were at one point (E8-10).
model DocumentVersion {
  /// The student this belongs to.
  userId     String       @default(dbgenerated("current_setting('app.user_id')"))
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  id         String       @id @default(cuid())
  documentId String
  document   Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  units      Json
  cause      VersionCause
  /// What changed, e.g. the part's name or the chat request.
  detail     String       @default("")
  createdAt  DateTime     @default(now())

  @@index([documentId, createdAt])
  @@index([userId])
}

enum ChatRole {
  USER
  AI
}

/// A message in an application's "Refine with AI" panel (APP-7).
model ChatMessage {
  /// The student this belongs to.
  userId        String      @default(dbgenerated("current_setting('app.user_id')"))
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  role          ChatRole
  text          String
  /// The unit the message is about ("About: Summary"), if any.
  targetUnit    String?
  /// Unit changes it made, with the previous text for Undo (editsSchema).
  edits         Json?
  undone        Boolean     @default(false)
  /// The letter's tone before this message changed it, for Undo; null when it didn't.
  previousTone  Tone?
  /// For AI messages, the prompt version that wrote it (E6-5).
  writtenWith   String?
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
  @@index([userId])
}

/// A private note or activity entry on an application (APP-14, E8-9).
model Note {
  /// The student this belongs to.
  userId        String      @default(dbgenerated("current_setting('app.user_id')"))
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime    @default(now())
  /// Shown as "edited" once it differs from createdAt (E8-9).
  updatedAt     DateTime    @default(now()) @updatedAt

  @@index([applicationId, createdAt])
  @@index([userId])
}

// ─── Job search (E14) ────────────────────────────────────────────────────────

/// The job sources Find jobs can search (E14-1 to E14-3).
enum PostingSource {
  JSEARCH
  ADZUNA
  ARBEITSAGENTUR
  FREEHIRE
}

/// A posting from Find jobs that the user kept (E14-5): saved, dismissed, or
/// started an application from. Plain search results aren't stored. The
/// fields follow the posting shape in src/lib/job-search/search.ts.
model Posting {
  /// The student this belongs to.
  userId        String        @default(dbgenerated("current_setting('app.user_id')"))
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  id            String        @id @default(cuid())
  source        PostingSource
  /// The source's own id for it.
  externalId    String
  title         String        @default("")
  company       String        @default("")
  place         String        @default("")
  /// Null when the source doesn't say.
  remote        Boolean?
  /// As the source writes it.
  salary        String        @default("")
  postedAt      DateTime?
  /// Where to read it or apply; always http(s).
  url           String        @default("")
  /// Where the source found it, e.g. "LinkedIn".
  via           String        @default("")
  description   String        @default("")
  /// False while the description is only the start of the posting.
  complete      Boolean       @default(false)
  savedAt       DateTime?
  /// Dismissed postings stay out of later searches.
  dismissedAt   DateTime?
  /// The application made from it; deleting the application keeps the posting.
  applicationId String?       @unique
  application   Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([userId, source, externalId])
  @@index([savedAt])
  @@index([dismissedAt])
}

/// A posting pasted into New application and handed to Claude chat (#221):
/// the Claude connector reads it by its id. It's kept for 14 days, then the
/// task-data sweep deletes it.
model ClaudePaste {
  /// The student this belongs to.
  userId    String   @default(dbgenerated("current_setting('app.user_id')"))
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  id        String   @id @default(uuid())
  text      String
  /// The posting's link, when one was given; always http(s), or empty.
  url       String   @default("")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

// ─── Job agent (E16) ─────────────────────────────────────────────────────────

/// A posting the job agent found and scored, and the draft it prepared from
/// it. Kept after it's dismissed, trimmed to what dedupe needs, so the same
/// posting never comes back.
model AgentCandidate {
  /// The student this belongs to.
  userId        String               @default(dbgenerated("current_setting('app.user_id')"))
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  id            String               @id @default(cuid())
  source        PostingSource
  /// The source's own id for it.
  externalId    String
  title         String               @default("")
  company       String               @default("")
  place         String               @default("")
  remote        Boolean?
  salary        String               @default("")
  postedAt      DateTime?
  /// Where to read it or apply; always http(s).
  url           String               @default("")
  via           String               @default("")
  /// Plain text, as the source gave it.
  description   String               @default("")
  complete      Boolean              @default(false)
  /// 0–100: how well the posting fits the profile (score-posting).
  score         Int                  @default(0)
  /// Why it fits, as a JSON list of strings.
  reasons       Json?
  /// What gives pause, as a JSON list of strings.
  redFlags      Json?
  status        AgentCandidateStatus @default(SCORED)
  /// Why preparing a draft failed, if it did.
  error         String?
  /// The tailored draft made from it.
  applicationId String?              @unique
  application   Application?         @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  /// A hash of the link without tracking parameters, else of company, title
  /// and place: the same job from another source or a later run matches.
  dedupeKey     String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([userId, source, externalId])
  @@unique([userId, dedupeKey])
  @@index([status, score])
  @@index([createdAt])
}

/// How well a posting fits the profile (#208): from Score in Find jobs, or
/// the job agent. Kept by the source's id, for search results that aren't
/// stored as postings, so the score shows again in later searches.
model PostingScore {
  /// The student this belongs to.
  userId     String        @default(dbgenerated("current_setting('app.user_id')"))
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source     PostingSource
  externalId String
  /// 0–100 (score-posting, or Jev).
  score      Int
  /// JSON lists of strings.
  reasons    Json
  redFlags   Json
  /// What scored it: the prompt version, e.g. "score-posting@1", or Jev's, e.g. "score-posting-jev@1 (jev-1.14.0)".
  scoredWith String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@id([userId, source, externalId])
}

/// A search on Find jobs, kept with what it found until the user removes it
/// (E14-10), so going back to it costs no searches from the source's plan.
model PostingSearch {
  /// The student this belongs to.
  userId    String        @default(dbgenerated("current_setting('app.user_id')"))
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  id        String        @id @default(cuid())
  source    PostingSource
  /// The search as asked (searchQuerySchema in src/lib/job-search/search.ts).
  query     Json
  /// The postings found, in order (foundPostingSchema[]); "Show more" adds to them.
  postings  Json
  /// How many postings it holds, for the Past searches list.
  found     Int           @default(0)
  /// What to ask the source for the next page; null on the last one.
  next      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([createdAt])
  @@index([userId])
}

// ─── Startups (#222) ─────────────────────────────────────────────────────────

/// Where a startup stands on the Startups screen.
enum StartupStatus {
  NEW
  SAVED
  CONTACTED
  DISMISSED
}

/// A startup that's hiring (#222): a YC startup's job post on Hacker News, or
/// a post in Hacker News' monthly "Who is hiring?" thread, with the addresses
/// it publishes for applications and how well it fits the profile. Kept
/// with what the user did with it; untouched ones go once no refresh finds
/// them for a while.
model Startup {
  /// The student this belongs to.
  userId             String        @default(dbgenerated("current_setting('app.user_id')"))
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  id                 String        @id @default(cuid())
  /// Where it was found: "YC" (YC's job posts) or "HN" ("Who is hiring?").
  source             String
  /// The Hacker News item's id.
  externalId         String
  company            String
  /// The company's own site, "" when unknown.
  website            String        @default("")
  /// The post's title, or its first line.
  summary            String        @default("")
  /// The post's text as published.
  details            String        @default("")
  location           String        @default("")
  remote             Boolean?
  /// e.g. "YC W24", or the round a post names.
  stage              String        @default("")
  /// JSON list of strings: the roles a post names.
  roles              Json
  /// JSON list of { email, label, from, onRequest, foundAt }: only addresses
  /// the startup published, never guessed. People's own addresses are
  /// looked up only when asked, and dropped after a while unless used.
  emails             Json
  /// JSON list of { label, url }.
  links              Json
  /// When it was posted.
  postedAt           DateTime?
  /// 0–100: how well it fits the profile, with why (JSON list of strings).
  score              Int           @default(0)
  reasons            Json
  /// The matching's version, e.g. "match@1".
  scoredWith         String        @default("")
  status             StartupStatus @default(NEW)
  /// Where its site says it takes no unsolicited applications; "" when it doesn't.
  noApplicationsFrom String        @default("")
  /// When its site was last checked for role addresses, and for people's.
  emailsCheckedAt    DateTime?
  peopleCheckedAt    DateTime?
  notes              String        @default("")
  /// When a refresh last found it.
  seenAt             DateTime      @default(now())
  /// The application started from it ("Write to them"); deleting the application keeps the startup.
  applicationId      String?       @unique
  application        Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([userId, source, externalId])
  @@index([status, score])
}

/// A startup removed with "Remove and don't bring back" (#222): only a
/// SHA-256 hash of its post, its site's domain or its name, so a refresh
/// leaves it out without keeping anything about it.
model StartupBlock {
  /// The student this belongs to.
  userId    String   @default(dbgenerated("current_setting('app.user_id')"))
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String
  createdAt DateTime @default(now())

  @@id([userId, hash])
}

// ─── Google: Gmail and Calendar (E15) ────────────────────────────────────────

/// The connected Google account; at most one row, with id "google". It
/// belongs to this install, not its data: exports leave it out.
model GoogleAccount {
  /// The student this belongs to.
  userId          String    @default(dbgenerated("current_setting('app.user_id')"))
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  id              String    @default("google")
  /// The Gmail address it's connected as.
  email           String
  /// The OAuth refresh token, encrypted like the API keys (GOOGLE_TOKEN).
  refreshTokenEnc String
  /// The scopes Google granted, space-separated.
  scopes          String    @default("")
  /// Where the inbox check carries on from (Gmail's history id).
  historyId       String?
  lastSyncAt      DateTime?
  /// Why the last check failed; null once one works again.
  syncProblem     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@id([userId, id])
}

enum EmailDirection {
  /// Sent from Dossier, or from Gmail in a thread Dossier knows.
  OUTGOING
  INCOMING
}

/// What a reply from an employer is, as the AI read it (E15-4).
enum ReplyKind {
  REJECTION
  INTERVIEW
  QUESTION
  OFFER
  /// An automatic "we got your application".
  ACKNOWLEDGEMENT
  OTHER
}

/// A mail in Gmail about an application, or one that may be (E15-3). Only
/// the text is kept, not attachments.
model EmailMessage {
  /// The student this belongs to.
  userId          String             @default(dbgenerated("current_setting('app.user_id')"))
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  id              String             @id @default(cuid())
  gmailId         String
  threadId        String
  /// Null while it isn't linked to an application ("Needs a look").
  /// Deleting the application deletes its mail, as it does its documents.
  applicationId   String?
  application     Application?       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  direction       EmailDirection
  fromName        String             @default("")
  fromAddress     String             @default("")
  toAddress       String             @default("")
  subject         String             @default("")
  /// The RFC 5322 Message-ID, for replying in the thread.
  messageId       String             @default("")
  /// The text, without quoted earlier mail, cut to a sensible length.
  body            String             @default("")
  sentAt          DateTime
  kind            ReplyKind?
  /// One line on what it says.
  summary         String             @default("")
  /// The questions it asks (stringList), for the reply to answer.
  questions       Json?
  /// The status it suggests moving to; null once handled or when there's none.
  suggestedStatus ApplicationStatus?
  /// The interview time it confirms, if any, for the calendar.
  confirmedAt     DateTime?
  /// The prompt version that read it.
  classifiedWith  String?
  /// The drafted answer, while there is one.
  replyDraft      String             @default("")
  /// What the draft couldn't answer from the profile (stringList).
  replyGaps       Json?
  draftedWith     String?
  /// Answered from Dossier, or marked as needing no answer.
  handledAt       DateTime?
  /// "Not job-related": only the ids and date are kept, so the inbox check
  /// doesn't fetch it again.
  dismissedAt     DateTime?
  createdAt       DateTime           @default(now())

  @@unique([userId, gmailId])
  @@index([threadId])
  @@index([applicationId, sentAt])
  @@index([sentAt])
}

// ─── Job boards (Pathfinder, auto-apply step 2) ──────────────────────────────

/// A job-board system whose public API the crawler reads, and whose forms the extension can fill.
enum BoardSystem {
  GREENHOUSE
  LEVER
  ASHBY
  SMARTRECRUITERS
}

/// A company whose public job board the crawler reads. Shared by everyone: no owner.
/// The table is also the crawl schedule: a worker takes companies whose nextCrawlAt has come.
model Company {
  id            String          @id @default(cuid())
  name          String
  system        BoardSystem
  /// The board's name on its system: Greenhouse board token, Lever site, Ashby job board, SmartRecruiters company id.
  boardToken    String
  /// Countries whose jobs are kept, as ISO codes ("in"); remote jobs open to anywhere are kept too.
  countries     String[]        @default(["in"])
  active        Boolean         @default(true)
  nextCrawlAt   DateTime        @default(now())
  /// A worker crawling it holds it until then; a crashed worker's hold just runs out.
  crawlingUntil DateTime?
  lastCrawledAt DateTime?
  /// Crawls in a row that failed; the wait before the next one grows with it.
  failures      Int             @default(0)
  /// Why the last crawl failed, for the admin console; never a posting's text.
  lastError     String?
  /// Open jobs kept from the last crawl.
  openJobs      Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  postings      SharedPosting[]

  @@unique([system, boardToken])
  @@index([active, nextCrawlAt])
}

/// A job from a company's public job board, shared by every student: job ads aren't personal.
model SharedPosting {
  id             String      @id @default(cuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  system         BoardSystem
  /// The board's own id for it.
  externalId     String
  title          String
  companyName    String
  location       String      @default("")
  /// ISO code ("in"), or "" when the board doesn't say and the place doesn't tell.
  country        String      @default("")
  /// Null when the board doesn't say.
  remote         Boolean?
  employmentType String      @default("")
  department     String      @default("")
  salary         String      @default("")
  /// Plain text, at most 100,000 characters.
  description    String
  /// The job's page.
  url            String
  /// The application form, where the extension applies.
  applyUrl       String
  postedAt       DateTime?
  firstSeenAt    DateTime    @default(now())
  lastSeenAt     DateTime    @default(now())
  /// Gone from the board since; set again to null if it comes back.
  closedAt       DateTime?
  /// A hash of company, title and place, so the same job from another source matches.
  dedupeKey      String
  /// A hash of what's shown, so a crawl only rewrites jobs that changed.
  contentHash    String
  // Pathfinder (step 3): the database also keeps a full-text search column, "search" (title,
  // department and description, generated from them, with a GIN index). Prisma can't describe
  // generated columns, so it lives only in migration 20261115090000_job_matching and is read
  // through raw SQL (src/lib/match/rank.ts).
  matches        JobMatch[]
  applyTasks     ApplyTask[]

  @@unique([companyId, externalId])
  @@index([closedAt, country])
  @@index([dedupeKey])
}

/// How well a job fits a student, as Pathfinder sorts its matches.
enum MatchTier {
  STRONG
  GOOD
  PARTIAL
  NOT_RECOMMENDED
}

/// Where a match stands: shortlisted by the ranking, then scored by the AI (or failed to be).
enum MatchStatus {
  RANKED
  SCORED
  FAILED
}

/// Pathfinder (auto-apply step 3): a shared job shortlisted for one student, and how well it fits.
model JobMatch {
  /// The student this belongs to.
  userId          String        @default(dbgenerated("current_setting('app.user_id')"))
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  id              String        @id @default(cuid())
  sharedPostingId String
  sharedPosting   SharedPosting @relation(fields: [sharedPostingId], references: [id], onDelete: Cascade)
  /// The full-text ranking's score when it was shortlisted; higher is closer to the profile.
  rank            Float
  status          MatchStatus   @default(RANKED)
  /// 0–100 from score-posting, once scored.
  score           Int?
  tier            MatchTier?
  /// Why it fits, and what gives pause (the gaps), as JSON lists of strings.
  reasons         Json?
  redFlags        Json?
  /// What scored it: the prompt version, e.g. "score-posting@1".
  scoredWith      String?
  /// Why scoring failed, in the student's words.
  error           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  applyTask       ApplyTask?

  @@unique([userId, sharedPostingId])
  @@index([userId, tier])
  @@index([sharedPostingId])
}

/// Pathfinder (auto-apply step 4): what a student allowed auto-apply to do, and the answers it uses.
/// One row per student.
model AutoApplySettings {
  /// The student this belongs to.
  userId          String    @id @default(dbgenerated("current_setting('app.user_id')"))
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Applications are submitted only while this is on, and only after consent.
  enabled         Boolean   @default(false)
  /// When the student agreed that Pathfinder may submit applications for them, and to which wording.
  consentAt       DateTime?
  consentVersion  String?
  /// What they're looking for (MatchPreferences); null until "Set up job search" is saved.
  preferences     Json?
  /// The weakest match applied for: STRONG, or GOOD (Strong and Good).
  minTier         MatchTier @default(GOOD)
  /// Applications a day at most, and per company in 30 days.
  dailyLimit      Int       @default(10)
  perCompanyLimit Int       @default(2)
  /// Fill everything but stop before Submit, to check the forms first. On until switched off.
  dryRun          Boolean   @default(true)
  /// Answers to the questions most forms ask (SavedAnswers), given once.
  answers         Json      @default("{}")
  updatedAt       DateTime  @updatedAt
}

/// Pathfinder (auto-apply step 5): a browser's Pathfinder extension, connected to a student. The
/// extension sends the token with each request; only its hash is kept, so the database can't
/// give it away.
model ExtensionToken {
  /// The student this belongs to.
  userId     String    @default(dbgenerated("current_setting('app.user_id')"))
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  id         String    @id @default(cuid())
  /// SHA-256 of the token, hex.
  tokenHash  String    @unique
  /// Which browser, as the student sees it ("Chrome on Windows").
  label      String    @default("")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime
  /// Disconnected by the student; refused from then on.
  revokedAt  DateTime?

  @@index([userId])
}

/// Where an application auto-apply prepares stands. The extension moves it on from READY.
enum ApplyState {
  /// Tailoring the resume and answering the form on the server.
  PREPARING
  /// Complete, waiting for the student's browser.
  READY
  /// A browser took it.
  LEASED
  /// The browser said it's about to press Submit: never retried automatically from here.
  SUBMITTING
  /// The confirmation was seen.
  APPLIED
  /// A puzzle, an emailed code, a question without an answer, or a form error: waits for the student.
  NEEDS_STUDENT
  /// Submit was pressed but no answer came back: the student checks.
  UNCERTAIN
  FAILED
  /// The student, or a limit, passed on it.
  SKIPPED
}

/// Pathfinder (auto-apply step 4): one application auto-apply prepares and submits for a student.
model ApplyTask {
  /// The student this belongs to.
  userId          String        @default(dbgenerated("current_setting('app.user_id')"))
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  id              String        @id @default(cuid())
  jobMatchId      String        @unique
  jobMatch        JobMatch      @relation(fields: [jobMatchId], references: [id], onDelete: Cascade)
  sharedPostingId String
  sharedPosting   SharedPosting @relation(fields: [sharedPostingId], references: [id], onDelete: Cascade)
  /// The application with the tailored resume and cover letter, once written.
  applicationId   String?       @unique
  application     Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  state           ApplyState    @default(PREPARING)
  /// The form's answers, by the form's own field names; every value from the profile or saved answers.
  answers         Json?
  /// Why it needs the student, failed or was skipped, in their words.
  reason          String?
  /// Which browser holds it, and until when.
  leaseId         String?
  leaseUntil      DateTime?
  /// Times a browser took it.
  attempts        Int           @default(0)
  /// What showed it was submitted: confirmation text, final address, time.
  evidence        Json?
  appliedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, sharedPostingId])
  @@index([userId, state])
}

// ─── Sign-in (E3-4) ──────────────────────────────────────────────────────────

/// Failed sign-in attempts, for rate limiting (AUTH-5): one row per client IP,
/// plus the key "*" counting attempts from all IPs together.
model LoginThrottle {
  /// The client IP, or "*" for the global counter.
  key          String    @id
  failures     Int       @default(0)
  /// When the current run of failures started.
  windowStart  DateTime
  /// Attempts are refused until then.
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([updatedAt])
}

/// Pathfinder: a shared allowance per outside service (a job board, an AI provider), so all workers
/// together stay within its rate limit. A token bucket: `tokens` refill over time up to the burst.
/// No owner: it belongs to the server, not to a student.
model ProviderBudget {
  /// e.g. "greenhouse" or "ai:gemini".
  provider  String   @id
  tokens    Float
  updatedAt DateTime @db.Timestamptz(3)
}

// ─── Background jobs (E6-7) ──────────────────────────────────────────────────

/// A job goes queued → running → done, or failed.
enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// A long AI task run in the background, e.g. reading a posting or writing the
/// documents. Each job type validates its own input and result (src/lib/jobs).
model Job {
  /// The student this belongs to.
  userId          String       @default(dbgenerated("current_setting('app.user_id')"))
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  id              String       @id @default(cuid())
  /// Which handler runs it, e.g. "extract-posting".
  type            String
  /// Finds the job again for something on screen, e.g. "application:<id>".
  key             String?
  /// The application it works on, if any: deleting the application deletes the job.
  applicationId   String?
  application     Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status          JobStatus    @default(QUEUED)
  /// The named step in progress, e.g. "Reading the posting".
  step            String?
  input           Json
  result          Json?
  /// Why it failed, written for the user.
  error           String?
  createdAt       DateTime     @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  updatedAt       DateTime     @updatedAt
  /// Pathfinder: the worker process running it (the Job table is the queue).
  workerId        String?
  /// When that worker last said it is still running; a stale one counts as interrupted.
  heartbeatAt     DateTime?
  /// Cancel was asked for in another process; the worker running it stops it.
  cancelRequested Boolean      @default(false)
  /// Pathfinder: the worker pool that takes it ("default", "crawl", "ai"…); PATHFINDER_QUEUES picks a worker's.
  queue           String       @default("default")
  /// Pathfinder: among one student's turn, higher runs first.
  priority        Int          @default(0)
  /// Pathfinder: times it was claimed, this run included.
  attempts        Int          @default(0)
  /// Pathfinder: runs before it stays failed. 1 means no automatic retry: the page offers Retry.
  maxAttempts     Int          @default(1)
  /// Pathfinder: not claimed before this, the wait before an automatic retry.
  runAfter        DateTime?
  /// Pathfinder: why the last run failed, in the student's words, while it waits to run again.
  lastError       String?

  @@index([key, createdAt])
  @@index([status])
  @@index([status, createdAt])
  @@index([status, runAfter])
  @@index([applicationId])
  @@index([userId])
}

/// What a tester tells us (Pathfinder, first testing release): read by the team on the server.
model Feedback {
  userId    String   @default(dbgenerated("current_setting('app.user_id')"))
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  id        String   @id @default(cuid())
  /// The page it was sent from, e.g. "/applications/abc".
  page      String   @default("")
  message   String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// Pathfinder: AI requests a student made on the server's shared key, per day (Asia/Kolkata), for
/// PATHFINDER_AI_DAILY_LIMIT. Kept when the student deletes everything, so that doesn't reset it.
model AiUsage {
  /// The student this belongs to.
  userId    String   @default(dbgenerated("current_setting('app.user_id')"))
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The day in India, e.g. "2026-11-06".
  day       String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, day])
}

/// Pathfinder: one call to the AI provider on the server's shared key, for the cost log: which
/// task, which model, the tokens it took and what it cost. Never the prompt or the answer.
model AiCall {
  id           String   @id @default(cuid())
  /// The student this belongs to.
  userId       String   @default(dbgenerated("current_setting('app.user_id')"))
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The task's schema name, e.g. "resume_review", or "text" for a plain answer.
  task         String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  /// In millionths of a US dollar, from the model's list price; null for a model without one.
  costMicroUsd Int?
  /// "ok", or the error's kind, e.g. "busy" (the backup model's call is a row of its own).
  outcome      String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Pathfinder: a resume analysis (upload → results): what was read from the resume and the review.
/// The resume's text itself isn't kept here.
model ResumeAnalysis {
  /// The student this belongs to.
  userId        String   @default(dbgenerated("current_setting('app.user_id')"))
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  id            String   @id @default(cuid())
  /// The uploaded file's name, e.g. "Asha Rao CV.pdf".
  fileName      String   @default("")
  /// The profile read from the resume (importedProfileSchema).
  profile       Json
  /// The review (resumeReviewSchema).
  review        Json
  /// The prompt versions that made it.
  readWith      String   @default("")
  /// Whether the student's empty profile was filled from this resume.
  profileFilled Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}
