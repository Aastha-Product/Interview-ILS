# The worker image: queues, PDF rendering with Chromium, housekeeping (docs/deploy.md).
#
#   docker build -f infra/Dockerfile.worker -t pathfinder-worker .
#
# Runs TypeScript through tsx, so it holds the whole workspace. No HTTP port: the host keeps one
# instance running and restarts it if it exits. No secrets are baked in.
FROM node:22-bookworm-slim
ENV CI=true PLAYWRIGHT_BROWSERS_PATH=0
RUN npm install -g pnpm@10.34.9
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
# Chromium (into node_modules) plus the system libraries it needs; apt needs root, so before USER.
RUN pnpm --filter @pathfinder/e2e install-browsers --with-deps && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
USER node
WORKDIR /app/apps/worker
CMD ["./node_modules/.bin/tsx", "src/index.ts"]
