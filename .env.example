# Copy to .env and fill in. Never commit .env.
# The app starts and all tests pass with every AI and feed key left empty (mocks are used).

# development | staging | production. Staging shows a "test data only" banner; demo seeding is refused in production.
APP_ENV=development

DATABASE_URL=postgresql://pathfinder:pathfinder@localhost:5432/pathfinder
# Used only by the integration tests; they reset this database.
TEST_DATABASE_URL=postgresql://pathfinder:pathfinder@localhost:5432/pathfinder_test

AUTH_SECRET=change-me
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google recommends pinning a specific stable model for production (for example gemini-3.6-flash).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional fallback model: any OpenAI-compatible Chat Completions API (base URL ending in /v1 or similar).
# Used for 2 minutes after Gemini fails 5 times in a minute, and once when Gemini fails every retry.
# Set all three or none. It receives the same student data as Gemini: use a paid tier that doesn't train on inputs.
FALLBACK_AI_BASE_URL=
FALLBACK_AI_API_KEY=
FALLBACK_AI_MODEL=

# Job feeds. With keys empty, recorded fixtures are used instead of live calls.
# JSearch: RapidAPI key for https://jsearch.p.rapidapi.com (v5, /search-v2). Free plan is about 200 requests a month.
JSEARCH_API_KEY=
JSEARCH_DAILY_BUDGET=6
# Adzuna: https://developer.adzuna.com. India support ("in") is not confirmed in their public docs; check in your account.
# Adzuna's terms require each displayed ad to be labelled and linked "Adzuna", and a licence for revenue-generating use.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_DAILY_BUDGET=50
# One live search per student per this many seconds; cached results are always allowed.
SEARCH_COOLDOWN_SECONDS=300
SEARCH_CACHE_HOURS=24

# Tailored drafts: per student per day (India time), and AI or PDF jobs one student may have running at once.
TAILOR_DAILY_LIMIT=20
AI_CONCURRENT_PER_USER=2

# Request limits (HTTP 429 with Retry-After when hit): API calls per signed-in student, and sign-in attempts per IP.
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_SIGNIN_PER_MINUTE=10

# File storage. "local" keeps files in .local/storage (development only).
# "s3" works with Cloudflare R2, AWS S3 or MinIO; production must use s3.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

SENTRY_DSN=
APP_URL=http://localhost:3000
# Proxies in front of the app that add to X-Forwarded-For: 1 on a container host, 2 with a CDN in front as well.
# Used to find the real client IP for the sign-in limit; a wrong value lets clients spoof it.
TRUSTED_PROXY_HOPS=1
LOG_LEVEL=info
