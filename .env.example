# Copy to .env and fill in. Never commit .env.
# The app starts and all tests pass with every AI and feed key left empty (mocks are used).

DATABASE_URL=postgresql://pathfinder:pathfinder@localhost:5432/pathfinder
# Used only by the integration tests; they reset this database.
TEST_DATABASE_URL=postgresql://pathfinder:pathfinder@localhost:5432/pathfinder_test

AUTH_SECRET=change-me
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google recommends pinning a specific stable model for production (for example gemini-3.6-flash).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
FALLBACK_AI_BASE_URL=
FALLBACK_AI_API_KEY=
FALLBACK_AI_MODEL=

JSEARCH_API_KEY=
JSEARCH_DAILY_BUDGET=6
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# File storage. "local" keeps files in .local/storage (development only).
# "s3" works with Cloudflare R2, AWS S3 or MinIO; production must use s3.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

SENTRY_DSN=
APP_URL=http://localhost:3000
LOG_LEVEL=info
